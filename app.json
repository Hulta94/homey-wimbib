  },
  "author": {
    "name": "Remne Technologies AB",
    "email": "hello@remne.tech"
  },
  "bugs": {
    "url": "https://github.com/remne/homey-wimbib/issues"
  },
  "source": "https://github.com/remne/homey-wimbib",
  "homepage": "https://remne.tech",
  "brandColor": "#0d47a2",
  "flow": {
    "triggers": [
      {
        "highlight": true,
        "title": {
          "en": "Burst alarm",
          "sv": "Spricklarm"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=wimbib"
          }
        ],
        "id": "alarm_water.burst_true"
      },
      {
        "highlight": true,
        "title": {
          "en": "Dry alarm",
          "sv": "Torrlarm"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=wimbib"
          }
        ],
        "id": "alarm_water.dry_true"
      },
      {
        "highlight": true,
        "title": {
          "en": "Reverse alarm",
          "sv": "Backflödeslarm"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=wimbib"
          }
        ],
        "id": "alarm_water.reverse_true"
      },
      {
        "title": {
          "en": "Actual flow changed",
          "sv": "Aktuellt flöde ändrat"
        },
        "tokens": [
          {
            "name": "measure_water",
            "title": {
              "en": "Actual flow",
              "sv": "Aktuellt flöde"
            },
            "type": "number",
            "example": 12.5
          }
        ],
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=wimbib"
          }
        ],
        "id": "measure_water.actual_changed"
      },
      {
        "highlight": true,
        "title": {
          "en": "Target volume changed",
          "sv": "Målvolym ändrad"
        },
        "tokens": [
          {
            "name": "meter_water.target",
            "title": {
              "en": "Target volume",
              "sv": "Målvolym"
            },
            "type": "number",
            "example": 25
          }
        ],
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=wimbib"
          }
        ],
        "id": "meter_water.target_changed"
      }
    ],
    "conditions": [
      {
        "title": {
          "en": "Actual flow !{{is|is not}} above",
          "sv": "Aktuellt flöde !{{är|är inte}} över"
        },
        "titleFormatted": {
          "en": "Actual flow !{{is|is not}} above [[flow]] L/min",
          "sv": "Aktuellt flöde !{{är|är inte}} över [[flow]] L/min"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=wimbib"
          },
          {
            "type": "number",
            "name": "flow",
            "min": 0,
            "step": 0.1,
            "placeholder": {
              "en": "L/min",
              "sv": "L/min"
            }
          }
        ],
        "id": "measure_water.actual_above"
      }
    ]
  },
  "drivers": [
    {
      "name": {
        "en": "wimbib"
      },
      "class": "sensor",
      "capabilities": [],
      "capabilitiesOptions": {},
      "energy": {
        "cumulative": true
      },
      "discovery": "wimbib",
      "platforms": [
        "local"
      ],
      "connectivity": [
        "lan"
      ],
      "images": {
        "small": "/drivers/wimbib/assets/images/small.png",
        "large": "/drivers/wimbib/assets/images/large.png",
        "xlarge": "/drivers/wimbib/assets/images/xlarge.png"
      },
      "pair": [
        {
          "id": "list_my_devices",
          "template": "list_devices",
          "navigation": {
            "next": "add_my_devices"
          },
          "options": {
            "singular": true
          }
        },
        {
          "id": "manual_add_view"
        },
        {
          "id": "add_my_devices",
          "template": "add_devices",
          "navigation": {
            "prev": "list_my_devices"
          }
        }
      ],
      "id": "wimbib"
    }
  ],
  "discovery": {
    "wimbib": {
      "type": "mdns-sd",
      "mdns-sd": {
        "name": "wimbib",
        "protocol": "tcp"
      },
      "id": "{{txt.id}}"
    }
  }
}